{
  "name": "perfect-logger",
  "version": "4.0.0",
  "description": "Enterprise-grade, zero-dependency, isomorphic logging framework for Node.js and Browsers inspired by Log4j 2.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.{js,ts}' --exit-on-fatal-error",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix",
    "prepublishOnly": "npm run build",
    "release": "standard-version --skip.test",
    "release:alpha": "standard-version --prerelease alpha --skip.test",
    "release:minor": "standard-version --release-as minor --skip.test",
    "release:major": "standard-version --release-as major --skip.test"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heysulo/perfect-logger.git"
  },
  "keywords": [
    "logger",
    "logging",
    "log4j",
    "enterprise",
    "mdc",
    "marker",
    "async-appender",
    "typescript",
    "isomorphic",
    "universal",
    "frontend",
    "backend",
    "zero-dependency"
  ],
  "author": "Sulochana Kodituwakku <sulochana.456@live.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.38.0",
    "jest": "^29.5.0",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
